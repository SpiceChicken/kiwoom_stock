# Copy only non-secret settings to a local, untracked environment file.
# KIWOOM_APP_KEY, KIWOOM_SECRET_KEY, and KIWOOM_BASE_URL are forbidden here.

KIWOOM_API_MODE=disabled
# check-only by default; host activation may select shadow-once or shadow-continuous.
KIWOOM_EXECUTION_MODE=check-only
KIWOOM_IMAGE_REF=
KIWOOM_IMAGE_DIGEST=
KIWOOM_REQUIRE_SHADOW_VOLUME=
KIWOOM_PROCESS_NAME=kiwoom-paper-monitor
KIWOOM_APP_ENV=local
KIWOOM_CREDENTIALS_DIR=
KIWOOM_OUTPUT_DIR=./runtime
KIWOOM_DB_PATH=./runtime/trades.db
KIWOOM_SLACK_WEBHOOK_URL=
KIWOOM_SLACK_BOT_TOKEN=
KIWOOM_SLACK_CHANNEL_ID=
KIWOOM_GEMINI_API_KEY=
KIWOOM_S3_BUCKET_NAME=
KIWOOM_AWS_REGION=
KIWOOM_FAST_INTERVAL_SECONDS=10
KIWOOM_SLOW_INTERVAL_SECONDS=60
KIWOOM_MAX_WORKERS=8
KIWOOM_MARKET_PROXY_CODE=069500
KIWOOM_MAX_STOCKS=50
KIWOOM_ETF_KEYWORDS=
KIWOOM_DEBUG_MODE=false
KIWOOM_DAY_TRADE_EXIT_TIME=15:30
KIWOOM_ENTRY_DEADLINE=15:00
KIWOOM_TOTAL_LOSS_LIMIT=-5
