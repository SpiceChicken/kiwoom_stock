{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Disabled-by-default C* shadow scheduler, ledger, observer, and evidence boundary",
  "Parameters": {
    "EnableActivationSchedules": {"Type":"String","AllowedValues":["true","false"],"Default":"false"},
    "EnableObserverRule": {"Type":"String","AllowedValues":["true","false"],"Default":"false"},
    "EnableReconciliationSchedules": {"Type":"String","AllowedValues":["true","false"],"Default":"false"},
    "SubmitterReservedConcurrency": {"Type":"Number","Default":0,"MinValue":0,"MaxValue":10},
    "ObserverReservedConcurrency": {"Type":"Number","Default":0,"MinValue":0,"MaxValue":10},
    "AlertMode": {"Type":"String","AllowedValues":["metrics-only","slack"],"Default":"metrics-only"},
    "InstanceId": {"Type":"AWS::EC2::Instance::Id","Default":"i-0e42e09d6c087ba29"},
    "ScheduleGeneration": {"Type":"String","Default":"cstar-g000001","AllowedPattern":"^cstar-g[0-9]{6,}$"},
    "PackageBucket": {"Type":"String"},
    "SubmitterPackageKey": {"Type":"String","Default":"cstar/submitter.zip"},
    "ObserverPackageKey": {"Type":"String","Default":"cstar/observer.zip"},
    "SlackSecretArn": {"Type":"String","Default":""}
  },
  "Conditions": {
    "ActivationEnabled": {"Fn::Equals":[{"Ref":"EnableActivationSchedules"},"true"]},
    "ObserverEnabled": {"Fn::Equals":[{"Ref":"EnableObserverRule"},"true"]},
    "ReconciliationEnabled": {"Fn::Equals":[{"Ref":"EnableReconciliationSchedules"},"true"]},
    "SlackEnabled": {"Fn::And":[{"Fn::Equals":[{"Ref":"AlertMode"},"slack"]},{"Fn::Not":[{"Fn::Equals":[{"Ref":"SlackSecretArn"},""]}]}]}
  },
  "Resources": {
    "ScheduleGroup": {
      "Type": "AWS::Scheduler::ScheduleGroup",
      "Properties": {"Name":"kiwoom-shadow-cstar"}
    },
    "EvidenceBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "ObjectLockEnabled": true,
        "ObjectLockConfiguration": {"ObjectLockEnabled":"Enabled","Rule":{"DefaultRetention":{"Mode":"GOVERNANCE","Days":400}}},
        "VersioningConfiguration": {"Status":"Enabled"},
        "BucketEncryption": {"ServerSideEncryptionConfiguration":[{"ServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]},
        "PublicAccessBlockConfiguration": {"BlockPublicAcls":true,"BlockPublicPolicy":true,"IgnorePublicAcls":true,"RestrictPublicBuckets":true}
      }
    },
    "CStarTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode":"PAY_PER_REQUEST",
        "AttributeDefinitions":[{"AttributeName":"PK","AttributeType":"S"},{"AttributeName":"SK","AttributeType":"S"},{"AttributeName":"closure_state","AttributeType":"S"},{"AttributeName":"next_action_at","AttributeType":"N"},{"AttributeName":"command_id","AttributeType":"S"}],
        "KeySchema":[{"AttributeName":"PK","KeyType":"HASH"},{"AttributeName":"SK","KeyType":"RANGE"}],
        "GlobalSecondaryIndexes":[{"IndexName":"closure-due-index","KeySchema":[{"AttributeName":"closure_state","KeyType":"HASH"},{"AttributeName":"next_action_at","KeyType":"RANGE"}],"Projection":{"ProjectionType":"ALL"}},{"IndexName":"command-index","KeySchema":[{"AttributeName":"command_id","KeyType":"HASH"},{"AttributeName":"PK","KeyType":"RANGE"}],"Projection":{"ProjectionType":"ALL"}}],
        "TimeToLiveSpecification":{"AttributeName":"expires_at","Enabled":true},
        "PointInTimeRecoverySpecification":{"PointInTimeRecoveryEnabled":true},
        "SSESpecification":{"SSEEnabled":true}
      }
    },
    "SubmitterDlq": {"Type":"AWS::SQS::Queue","Properties":{"MessageRetentionPeriod":1209600}},
    "ObserverDlq": {"Type":"AWS::SQS::Queue","Properties":{"MessageRetentionPeriod":1209600}},
    "ReconciliationDlq": {"Type":"AWS::SQS::Queue","Properties":{"MessageRetentionPeriod":1209600}},
    "SubmitterRole": {
      "Type":"AWS::IAM::Role",
      "Properties":{
        "AssumeRolePolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Service":"lambda.amazonaws.com"},"Action":"sts:AssumeRole"}]},
        "Policies":[{"PolicyName":"cstar-submitter-minimal","PolicyDocument":{"Version":"2012-10-17","Statement":[
          {"Effect":"Allow","Action":["dynamodb:GetItem","dynamodb:TransactWriteItems","dynamodb:UpdateItem"],"Resource":{"Fn::GetAtt":["CStarTable","Arn"]}},
          {"Effect":"Allow","Action":"ssm:SendCommand","Resource":[{"Fn::Join":["",["arn:",{"Ref":"AWS::Partition"},":ssm:",{"Ref":"AWS::Region"},":",{"Ref":"AWS::AccountId"},":document/KiwoomStock-ShadowCStarActivation"]]},{"Fn::Join":["",["arn:",{"Ref":"AWS::Partition"},":ec2:",{"Ref":"AWS::Region"},":",{"Ref":"AWS::AccountId"},":instance/",{"Ref":"InstanceId"}]]}]},
          {"Effect":"Allow","Action":["logs:CreateLogStream","logs:PutLogEvents"],"Resource":{"Fn::Sub":"arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/*:*"}},
          {"Effect":"Allow","Action":"cloudwatch:PutMetricData","Resource":"*","Condition":{"StringEquals":{"cloudwatch:namespace":"Kiwoom/ShadowCStar"}}}
        ]}}]
      }
    },
    "ObserverRole": {
      "Type":"AWS::IAM::Role",
      "Properties":{
        "AssumeRolePolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Service":"lambda.amazonaws.com"},"Action":"sts:AssumeRole"}]},
        "Policies":[{"PolicyName":"cstar-observer-minimal","PolicyDocument":{"Version":"2012-10-17","Statement":[
          {"Effect":"Allow","Action":["dynamodb:GetItem","dynamodb:Query","dynamodb:UpdateItem"],"Resource":[{"Fn::GetAtt":["CStarTable","Arn"]},{"Fn::Join":["", [{"Fn::GetAtt":["CStarTable","Arn"]},"/index/closure-due-index"]]}]},
          {"Effect":"Allow","Action":["ssm:GetCommandInvocation","ssm:ListCommandInvocations"],"Resource":"*"},
          {"Effect":"Allow","Action":"ssm:SendCommand","Resource":[{"Fn::Join":["",["arn:",{"Ref":"AWS::Partition"},":ssm:",{"Ref":"AWS::Region"},":",{"Ref":"AWS::AccountId"},":document/KiwoomStock-ShadowEvidenceExport"]]},{"Fn::Join":["",["arn:",{"Ref":"AWS::Partition"},":ec2:",{"Ref":"AWS::Region"},":",{"Ref":"AWS::AccountId"},":instance/",{"Ref":"InstanceId"}]]}]},
          {"Effect":"Allow","Action":["s3:PutObject","s3:AbortMultipartUpload"],"Resource":{"Fn::Join":["", [{"Fn::GetAtt":["EvidenceBucket","Arn"]},"/sessions/*"]]}},
          {"Effect":"Allow","Action":["secretsmanager:GetSecretValue"],"Resource":{"Fn::If":["SlackEnabled",{"Ref":"SlackSecretArn"},{"Fn::Join":["",["arn:",{"Ref":"AWS::Partition"},":secretsmanager:",{"Ref":"AWS::Region"},":",{"Ref":"AWS::AccountId"},":secret:cstar-disabled"]]}]},"Condition":{"StringEquals":{"aws:ResourceTag/kiwoom-cstar-observer":"true"}}},
          {"Effect":"Allow","Action":["logs:CreateLogStream","logs:PutLogEvents"],"Resource":{"Fn::Sub":"arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/*:*"}},
          {"Effect":"Allow","Action":"cloudwatch:PutMetricData","Resource":"*","Condition":{"StringEquals":{"cloudwatch:namespace":"Kiwoom/ShadowCStar"}}}
        ]}}]
      }
    },
    "SchedulerRole": {
      "Type":"AWS::IAM::Role",
      "Properties":{
        "AssumeRolePolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Service":"scheduler.amazonaws.com"},"Action":"sts:AssumeRole","Condition":{"StringEquals":{"aws:SourceAccount":{"Ref":"AWS::AccountId"}}}}]},
        "Policies":[{"PolicyName":"cstar-scheduler-submit","PolicyDocument":{"Version":"2012-10-17","Statement":[
          {"Effect":"Allow","Action":"lambda:InvokeFunction","Resource":[{"Ref":"SubmitterAlias"},{"Ref":"ObserverAlias"}]},
          {"Effect":"Allow","Action":"sqs:SendMessage","Resource":[{"Fn::GetAtt":["SubmitterDlq","Arn"]},{"Fn::GetAtt":["ObserverDlq","Arn"]},{"Fn::GetAtt":["ReconciliationDlq","Arn"]}]}
        ]}}]
      }
    },
    "SubmitterFunction": {
      "Type":"AWS::Lambda::Function",
      "Properties":{"Runtime":"python3.11","Handler":"shadow_cstar_submitter.lambda_handler","Role":{"Fn::GetAtt":["SubmitterRole","Arn"]},"Code":{"S3Bucket":{"Ref":"PackageBucket"},"S3Key":{"Ref":"SubmitterPackageKey"}},"Environment":{"Variables":{"CSTAR_TABLE_NAME":{"Ref":"CStarTable"}}},"Timeout":30,"MemorySize":256,"ReservedConcurrentExecutions":{"Fn::If":["ActivationEnabled",{"Ref":"AWS::NoValue"},{"Ref":"SubmitterReservedConcurrency"}]}}
    },
    "ObserverFunction": {
      "Type":"AWS::Lambda::Function",
      "Properties":{"Runtime":"python3.11","Handler":"shadow_cstar_observer.lambda_handler","Role":{"Fn::GetAtt":["ObserverRole","Arn"]},"Code":{"S3Bucket":{"Ref":"PackageBucket"},"S3Key":{"Ref":"ObserverPackageKey"}},"Environment":{"Variables":{"CSTAR_TABLE_NAME":{"Ref":"CStarTable"},"CSTAR_EVIDENCE_BUCKET":{"Ref":"EvidenceBucket"},"CSTAR_ALERT_MODE":{"Ref":"AlertMode"},"CSTAR_SLACK_SECRET_ARN":{"Ref":"SlackSecretArn"}}},"Timeout":60,"MemorySize":256,"ReservedConcurrentExecutions":{"Fn::If":["ObserverEnabled",{"Ref":"AWS::NoValue"},{"Ref":"ObserverReservedConcurrency"}]}}
    },
    "SubmitterLogGroup": {
      "Type":"AWS::Logs::LogGroup",
      "DeletionPolicy":"Retain",
      "UpdateReplacePolicy":"Retain",
      "Properties":{"LogGroupName":{"Fn::Sub":["/aws/lambda/${FunctionName}",{"FunctionName":{"Ref":"SubmitterFunction"}}]},"RetentionInDays":30}
    },
    "ObserverLogGroup": {
      "Type":"AWS::Logs::LogGroup",
      "DeletionPolicy":"Retain",
      "UpdateReplacePolicy":"Retain",
      "Properties":{"LogGroupName":{"Fn::Sub":["/aws/lambda/${FunctionName}",{"FunctionName":{"Ref":"ObserverFunction"}}]},"RetentionInDays":30}
    },
    "SubmitterVersion": {"Type":"AWS::Lambda::Version","Properties":{"FunctionName":{"Ref":"SubmitterFunction"}}},
    "ObserverVersion": {"Type":"AWS::Lambda::Version","Properties":{"FunctionName":{"Ref":"ObserverFunction"}}},
    "SubmitterAlias": {"Type":"AWS::Lambda::Alias","Properties":{"FunctionName":{"Ref":"SubmitterFunction"},"FunctionVersion":{"Fn::GetAtt":["SubmitterVersion","Version"]},"Name":"live"}},
    "ObserverAlias": {"Type":"AWS::Lambda::Alias","Properties":{"FunctionName":{"Ref":"ObserverFunction"},"FunctionVersion":{"Fn::GetAtt":["ObserverVersion","Version"]},"Name":"live"}},
    "StartSchedule": {
      "Condition":"ActivationEnabled","Type":"AWS::Scheduler::Schedule",
      "Properties":{"GroupName":{"Ref":"ScheduleGroup"},"Name":"kiwoom-shadow-cstar-start","ScheduleExpression":"cron(50 8 ? * MON-FRI *)","ScheduleExpressionTimezone":"Asia/Seoul","FlexibleTimeWindow":{"Mode":"OFF"},"Target":{"Arn":{"Ref":"SubmitterAlias"},"RoleArn":{"Fn::GetAtt":["SchedulerRole","Arn"]},"Input":"{\"schema_version\":1,\"phase\":\"start\",\"schedule_generation\":\"cstar-g000001\",\"schedule_arn\":\"<aws.scheduler.schedule-arn>\",\"scheduled_time\":\"<aws.scheduler.scheduled-time>\",\"execution_id\":\"<aws.scheduler.execution-id>\",\"attempt_number\":\"<aws.scheduler.attempt-number>\"}","RetryPolicy":{"MaximumEventAgeInSeconds":480,"MaximumRetryAttempts":2},"DeadLetterConfig":{"Arn":{"Fn::GetAtt":["SubmitterDlq","Arn"]}}}}
    },
    "StopSchedule": {
      "Condition":"ActivationEnabled","Type":"AWS::Scheduler::Schedule",
      "Properties":{"GroupName":{"Ref":"ScheduleGroup"},"Name":"kiwoom-shadow-cstar-stop","ScheduleExpression":"cron(35 15 ? * MON-FRI *)","ScheduleExpressionTimezone":"Asia/Seoul","FlexibleTimeWindow":{"Mode":"OFF"},"Target":{"Arn":{"Ref":"SubmitterAlias"},"RoleArn":{"Fn::GetAtt":["SchedulerRole","Arn"]},"Input":"{\"schema_version\":1,\"phase\":\"stop\",\"schedule_generation\":\"cstar-g000001\",\"schedule_arn\":\"<aws.scheduler.schedule-arn>\",\"scheduled_time\":\"<aws.scheduler.scheduled-time>\",\"execution_id\":\"<aws.scheduler.execution-id>\",\"attempt_number\":\"<aws.scheduler.attempt-number>\"}","RetryPolicy":{"MaximumEventAgeInSeconds":900,"MaximumRetryAttempts":2},"DeadLetterConfig":{"Arn":{"Fn::GetAtt":["SubmitterDlq","Arn"]}}}}
    },
    "ObserverRule": {
      "Condition":"ObserverEnabled","Type":"AWS::Events::Rule",
      "Properties":{"EventPattern":{"source":["aws.ssm"],"detail-type":["EC2 Command Status-change Notification"],"detail":{"instance-id":[{"Ref":"InstanceId"}],"document-name":["KiwoomStock-ShadowCStarActivation","KiwoomStock-ShadowEvidenceExport"]}},"Targets":[{"Arn":{"Ref":"ObserverAlias"},"Id":"cstar-observer","DeadLetterConfig":{"Arn":{"Fn::GetAtt":["ObserverDlq","Arn"]}}}]}
    },
    "ObserverInvokePermission": {"Condition":"ObserverEnabled","Type":"AWS::Lambda::Permission","Properties":{"Action":"lambda:InvokeFunction","FunctionName":{"Ref":"ObserverAlias"},"Principal":"events.amazonaws.com","SourceArn":{"Fn::GetAtt":["ObserverRule","Arn"]}}},
    "ReconcileSchedule": {
      "Condition":"ReconciliationEnabled","Type":"AWS::Scheduler::Schedule",
      "Properties":{"GroupName":{"Ref":"ScheduleGroup"},"Name":"kiwoom-shadow-cstar-reconcile","ScheduleExpression":"rate(5 minutes)","ScheduleExpressionTimezone":"Asia/Seoul","FlexibleTimeWindow":{"Mode":"OFF"},"Target":{"Arn":{"Ref":"ObserverAlias"},"RoleArn":{"Fn::GetAtt":["SchedulerRole","Arn"]},"Input":"{\"kind\":\"reconcile\",\"schema_version\":1}","RetryPolicy":{"MaximumEventAgeInSeconds":300,"MaximumRetryAttempts":2},"DeadLetterConfig":{"Arn":{"Fn::GetAtt":["ReconciliationDlq","Arn"]}}}}
    },
    "SubmitterErrorAlarm": {"Type":"AWS::CloudWatch::Alarm","Properties":{"Namespace":"AWS/Lambda","MetricName":"Errors","Dimensions":[{"Name":"FunctionName","Value":{"Ref":"SubmitterFunction"}}],"Statistic":"Sum","Period":300,"EvaluationPeriods":1,"Threshold":1,"ComparisonOperator":"GreaterThanOrEqualToThreshold","TreatMissingData":"notBreaching","AlarmDescription":"C* submitter error"}},
    "SubmitterRejectedAlarm": {"Type":"AWS::CloudWatch::Alarm","Properties":{"Namespace":"Kiwoom/ShadowCStar","MetricName":"cstar_activation_rejected","Statistic":"Sum","Period":300,"EvaluationPeriods":1,"Threshold":1,"ComparisonOperator":"GreaterThanOrEqualToThreshold","TreatMissingData":"notBreaching","AlarmDescription":"C* submitter admission rejection"}}
  },
  "Outputs": {
    "CStarTableName": {"Value":{"Ref":"CStarTable"}},
    "EvidenceBucketName": {"Value":{"Ref":"EvidenceBucket"}},
    "ActivationSchedulesDisabledByDefault": {"Value":{"Ref":"EnableActivationSchedules"}},
    "ObserverDisabledByDefault": {"Value":{"Ref":"EnableObserverRule"}}
  }
}
