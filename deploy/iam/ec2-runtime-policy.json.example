{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadExactKiwoomParameters",
      "Effect": "Allow",
      "Action": ["ssm:GetParameters"],
      "Resource": [
        "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/kiwoom-stock/prod/oauth/app-key",
        "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/kiwoom-stock/prod/oauth/secret-key"
      ]
    }
  ]
}
