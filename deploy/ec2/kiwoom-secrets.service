[Unit]
Description=Materialize Kiwoom credentials from AWS Systems Manager Parameter Store
Wants=network-online.target
After=network-online.target
Before=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/kiwoom/kiwoom-secrets.conf
ExecStart=/opt/kiwoom-stock/.venv/bin/python /usr/local/libexec/materialize_kiwoom_secrets.py
RuntimeDirectory=kiwoom-stock
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/kiwoom-stock
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
