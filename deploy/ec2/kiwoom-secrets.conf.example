# Root-owned (0640 or stricter) configuration. Values are parameter names,
# never secret values. The service account reads these through systemd.
KIWOOM_AWS_REGION=ap-northeast-2
KIWOOM_APP_PARAMETER=/kiwoom-stock/prod/oauth/app-key
KIWOOM_SECRET_PARAMETER=/kiwoom-stock/prod/oauth/secret-key
KIWOOM_SECRET_DIR=/run/kiwoom-stock/credentials
KIWOOM_SECRET_UID=0
KIWOOM_SECRET_GID=0
